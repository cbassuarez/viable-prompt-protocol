{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viableprompt.org/protocol/v1.5/state.schema.json",
  "title": "VPP Conversation State",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "locus", "cycle", "tag_counts", "closed"],
  "properties": {
    "protocol_version": { "const": "v1.5" },
    "locus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._/-]*$"
        }
      }
    },
    "cycle": { "type": "integer", "minimum": 1, "maximum": 3 },
    "tag_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["g", "q", "o", "c", "o_f"],
      "properties": {
        "g": { "type": "integer", "minimum": 0 },
        "q": { "type": "integer", "minimum": 0 },
        "o": { "type": "integer", "minimum": 0 },
        "c": { "type": "integer", "minimum": 0 },
        "o_f": { "type": "integer", "minimum": 0 }
      }
    },
    "closed": { "type": "boolean" }
  }
}
