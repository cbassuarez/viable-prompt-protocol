{
  "name": "viable-prompt-protocol",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "run:exp1-protret": "node experiments/exp1-protocol-retention/run-exp1-protret.mjs",
    "test:corpus": "node scripts/validate-corpus.mjs",
    "analyze:exp1": "node experiments/exp1-protocol-retention/analyze-exp1.mjs",
    "run:exp2-promptinj": "node experiments/exp2-prompt-injection/run-exp2-promptinj.mjs",
    "analyze:exp2": "node experiments/exp2-prompt-injection/analyze-exp2.mjs",
    "run:exp1b-user-only": "node experiments/exp1b-user-only-protocol/run-exp1b-user-only.mjs",
    "analyze:exp1b": "node experiments/exp1b-user-only-protocol/analyze-exp1b.mjs",
    "run:exp3-taskinj": "node experiments/exp3-task-injection/run-exp3-taskinj.mjs",
    "analyze:exp3": "node experiments/exp3-task-injection/analyze-exp3.mjs",
    "run:exp4-taskutil": "node experiments/exp4-task-utility/run-exp4-taskutil.mjs",
    "analyze:exp4": "node experiments/exp4-task-utility/analyze-exp4.mjs",
    "run:exp5-friction": "node experiments/exp5-friction-convergence/run-exp5-friction.mjs",
    "analyze:exp5": "node experiments/exp5-friction-convergence/analyze-exp5.mjs",
    "run:exp6-longdialog": "node experiments/exp6-long-dialog/run-exp6-longdialog.mjs",
    "analyze:exp6": "node experiments/exp6-long-dialog/analyze-exp6.mjs",
    "docs:dev": "vitepress dev website/docs",
    "docs:build": "vitepress build website/docs",
    "docs:preview": "vitepress preview website/docs",
    "lint:md": "markdownlint-cli2 \"README.md\" \"docs/**/*.md\" \"website/docs/**/*.md\" \"contributing.md\" \"code_of_conduct.md\" \"RELEASE_NOTES_v1.4.md\" \"!docs/spec/**\" \"!docs/latest/spec.md\" \"!docs/adoption/v1.5.md\" \"!website/docs/spec/index.md\" \"!spec/**\"",
    "lint:spell": "cspell --no-progress \"docs/**/*.md\" \"spec/**/*.md\" \"website/docs/**/*.md\" \"README.md\"",
    "test:parser": "node scripts/test-transcripts.mjs",
    "build:index": "node scripts/build-index.mjs --all",
    "validate": "node scripts/validate-corpus.mjs && node scripts/build-index.mjs --check --all",
    "build:corpus-data": "node scripts/build-corpus-data.mjs",
    "generate:vpp": "node scripts/generate-v15.mjs",
    "check:generated": "node scripts/generate-v15.mjs --check",
    "typecheck": "tsc --noEmit",
    "test:vpp": "node --import tsx --test tests/vpp-*.test.ts",
    "test:worker-local": "node scripts/test-worker-local.mjs",
    "build:skill-script": "esbuild src/offline-cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=plugins/viable-prompt-protocol/skills/viable-prompt-protocol/scripts/vpp.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "check:plugin-package": "node scripts/package-plugin.mjs --check",
    "build:worker": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler deploy --env=\"\" --dry-run --outdir .scratch/worker",
    "deploy:production": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler deploy --env=\"\"",
    "deploy:preview": "WRANGLER_WRITE_LOGS=false WRANGLER_SEND_METRICS=false wrangler deploy --env preview",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "smoke:openai-mcp": "node scripts/smoke-openai-mcp.mjs",
    "validate:vpp-artifacts": "node scripts/validate-vpp-artifacts.mjs",
    "validate:openai-submission": "node scripts/validate-openai-submission.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cspell": "^9.3.1",
    "esbuild": "^0.28.2",
    "markdown-it-mathjax3": "^4.3.2",
    "markdownlint-cli2": "^0.19.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "wrangler": "^4.123.0"
  }
}
