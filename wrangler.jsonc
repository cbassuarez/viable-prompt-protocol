{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "viable-prompt-protocol",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "mcp.viableprompt.org",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": false },
  "limits": {
    "cpu_ms": 50
  },
  "ratelimits": [
    {
      "name": "VPP_RATE_LIMITER",
      "namespace_id": "1501",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "env": {
    "preview": {
      "name": "viable-prompt-protocol-preview",
      "workers_dev": true,
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "VPP_RATE_LIMITER",
          "namespace_id": "1502",
          "simple": {
            "limit": 120,
            "period": 60
          }
        }
      ]
    }
  }
}
